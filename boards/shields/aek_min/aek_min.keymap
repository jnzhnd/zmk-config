#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/backlight.h>
#include "keys_de_swiss.h"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // LAYER 0
            display-name = "Base";
            bindings = <
                &kp ESC          &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_SEARCH     &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT &none     &kp C_MUTE &kp C_VOLUME_DOWN &kp C_VOLUME_UP &none              &kp F13 &kp F14 &kp F15                                   &kp C_POWER 
                
                &kp DE_LESS_THAN   &kp DE_N1 &kp DE_N2 &kp DE_N3 &kp DE_N4 &kp DE_N5 &kp DE_N6 &kp DE_N7 &kp DE_N8 &kp DE_N9 &kp DE_N0 &kp DE_SINGLE_QUOTE &kp DE_CARET &kp BACKSPACE           &mo 1 &kp HOME &kp PAGE_UP           &kp LOCKING_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY 
                &kp TAB       &kp DE_Q &kp DE_W &kp DE_E &kp DE_R &kp DE_T &kp DE_Z &kp DE_U &kp DE_I &kp DE_O &kp DE_P &kp DE_U_UMLAUT &kp DE_EXCLAMATION                                      &kp DELETE &kp END &kp PAGE_DOWN     &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9 &kp KP_MINUS
                &kp CAPSLOCK         &kp DE_A &kp DE_S &kp DE_D &kp DE_F &kp DE_G &kp DE_H &kp DE_J &kp DE_K &kp DE_L &kp DE_O_UMLAUT &kp DE_A_UMLAUT &kp DE_DOLLAR &kp ENTER                                                        &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6 &kp KP_PLUS
                &kp LEFT_SHIFT     &kp DE_SECTION &kp DE_Y &kp DE_X &kp DE_C &kp DE_V &kp DE_B &kp DE_N &kp DE_M &kp DE_COMMA &kp DE_PERIOD &kp DE_MINUS &kp RIGHT_SHIFT                              &kp UP_ARROW                 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_3 &kp KP_ENTER
                &kp LEFT_CONTROL    &kp LEFT_ALT   &kp LEFT_GUI    &kp SPACE                                            &kp RIGHT_GUI    &kp RIGHT_ALT   &kp RIGHT_CONTROL         &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW     &kp KP_NUMBER_0        &kp KP_DOT  
            >;
        };

        media_layer { // LAYER 1
            display-name = "Media";

            bindings = <
                &none         &kp F1 &kp F2 &kp F3 &kp F4     &kp F5 &kp F6 &kp F7 &kp F8     &kp F9 &kp F10 &kp F11 &kp F12              &none &none &none            &none 
                
                &none   &none &none &none &none &none &none &none &none &none &none &none &none &none           &none &none &none           &none &none &none &none 
                &none       &none &none &none &none &none &none &none &none &none &none &none &none                                      &none &none &none     &none &none &none &none
                &none         &none &none &none &none &none &none &none &none &none &none &none &none &none                                                        &none &none &none &none
                &none     &none &none &none &none &none &none &none &none &none &none &none &none                              &none                 &none &none &none &none
                &none    &mo 2   &none    &none                                            &none    &mo 2   &none         &none &none &none     &none        &none  
            >;
        };

        system_layer { // LAYER 2
            display-name = "System";

            bindings = <
                &sys_reset         &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_CLR &none &none &none     &bl BL_TOG &none &none &none              &none &none &none             &studio_unlock 
                
                &none   &none &none &none &none &none &none &none &none &none &none &none &none &none           &none &none &none           &none &none &none &none 
                &none       &none &none &none &none &none &none &none &none &none &none &none &none                                      &none &none &none     &none &none &none &none
                &none         &none &none &none &none &none &none &none &none &none &none &none &none &none                                                        &none &none &none &none
                &none     &none &none &none &none &none &none &none &none &none &none &none &none                              &none                 &none &none &none &none
                &none    &none   &none    &none                                            &none    &none   &none         &none &none &none     &none        &bootloader 
            >;
        };
    };
};
